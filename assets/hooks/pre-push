#!/bin/sh
# husky-skill · pre-push
# Última puerta antes de que el código salga de tu máquina.
# Acá va la carga pesada: type-check completo, build, tests.
# Bypass individual: SKIP_TYPESCRIPT=1 / SKIP_BUILD=1 / SKIP_TESTS=1
# Bypass total (emergencias): HUSKY=0 git push  /  git push --no-verify
#
# Nota de diseño: esto NO reemplaza CI. Cualquiera puede pushear con
# --no-verify; el gate obligatorio siempre es el pipeline remoto.

[ "$HUSKY" = "0" ] && exit 0

if [ -t 2 ]; then
  RED=$(printf '\033[0;31m'); GREEN=$(printf '\033[0;32m')
  YELLOW=$(printf '\033[0;33m'); NC=$(printf '\033[0m')
else
  RED=''; GREEN=''; YELLOW=''; NC=''
fi

fail() { printf '%s✖ %s%s\n' "$RED" "$1" "$NC" >&2; exit 1; }
info() { printf '%s· %s%s\n' "$YELLOW" "$1" "$NC" >&2; }
ok()   { printf '%s✔ %s%s\n' "$GREEN" "$1" "$NC" >&2; }

# Detectar si hay algo que pushear (stdin: <local ref> <sha> <remote ref> <sha>)
PUSHING=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Borrado de branch remoto: local_sha = 40 ceros → no hay nada que validar
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  PUSHING=1
done
[ "$PUSHING" -eq 0 ] && exit 0

has_script() {
  [ -f package.json ] || return 1
  node -e "process.exit(((require('./package.json').scripts||{})['$1'])?0:1)" 2>/dev/null
}

# ---------------------------------------------------------------
# 1. Type-check completo (no solo staged: errores cross-file)
# ---------------------------------------------------------------
if [ "$SKIP_TYPESCRIPT" != "1" ] && [ -f tsconfig.json ] && [ -x node_modules/.bin/tsc ]; then
  info "tsc --noEmit (proyecto completo)…"
  node_modules/.bin/tsc --noEmit || fail "Errores de tipos. Corregilos antes de pushear."
elif [ "$SKIP_TYPESCRIPT" = "1" ]; then
  info "Type-check saltado (SKIP_TYPESCRIPT=1)"
fi

# ---------------------------------------------------------------
# 2. Build (tsc no atrapa todo: bundler, imports, assets, env)
# ---------------------------------------------------------------
if [ "$SKIP_BUILD" != "1" ] && has_script build; then
  info "npm run build…"
  npm run build --silent || fail "El build falló. Un build roto nunca debe llegar al remoto."
elif [ "$SKIP_BUILD" = "1" ]; then
  info "Build saltado (SKIP_BUILD=1)"
fi

# ---------------------------------------------------------------
# 3. Tests
# ---------------------------------------------------------------
if [ "$SKIP_TESTS" != "1" ] && has_script test; then
  # Ignorar el placeholder por defecto de npm init
  if node -e "const t=(require('./package.json').scripts||{}).test||'';process.exit(/no test specified/.test(t)?1:0)" 2>/dev/null; then
    info "npm test…"
    npm test --silent || fail "Tests fallando. Arreglalos antes de pushear."
  fi
elif [ "$SKIP_TESTS" = "1" ]; then
  info "Tests saltados (SKIP_TESTS=1)"
fi

ok "pre-push OK — código validado antes de salir de tu máquina"
exit 0
