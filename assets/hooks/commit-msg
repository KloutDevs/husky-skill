#!/bin/sh
# husky-skill · commit-msg
# Validates Conventional Commits with zero dependencies (no commitlint, no Node).
# Format:  type(scope)!: subject
#   - type required, from the list below
#   - (scope) optional, lowercase/digits/dashes
#   - ! optional (breaking change)
#   - subject required, 1-72 chars on the first line
# Auto-skipped: merges, generated reverts, fixup!/squash!.

[ "$HUSKY" = "0" ] && exit 0

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

if [ -t 2 ]; then
  RED=$(printf '\033[0;31m'); GREEN=$(printf '\033[0;32m'); NC=$(printf '\033[0m')
else
  RED=''; GREEN=''; NC=''
fi

# First line, comments stripped
FIRST=$(grep -v '^#' "$MSG_FILE" | head -1)

# Empty → let git handle it (it aborts on its own)
[ -z "$FIRST" ] && exit 0

# Git-generated cases that must not be validated
case "$FIRST" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s' "$FIRST" | grep -qE "^($TYPES)(\([a-z0-9-]+\))?!?: .+" ; then
  printf '%s✖ Invalid commit message:%s\n' "$RED" "$NC" >&2
  printf '  "%s"\n\n' "$FIRST" >&2
  printf 'Required format (Conventional Commits):\n' >&2
  printf '  type(scope): subject\n\n' >&2
  printf 'Valid types: feat fix docs style refactor perf test build ci chore revert\n\n' >&2
  printf 'Examples:\n' >&2
  printf '  feat(auth): add OAuth2 login\n' >&2
  printf '  fix(api): fix null pointer in /users\n' >&2
  printf '  chore: update dependencies\n' >&2
  printf '  feat(payments)!: switch base currency to USD  (breaking)\n' >&2
  exit 1
fi

LEN=${#FIRST}
if [ "$LEN" -gt 72 ]; then
  printf '%s✖ First line too long: %s chars (max 72).%s\n' "$RED" "$LEN" "$NC" >&2
  printf '  Move the detail to the commit body (blank line + description).\n' >&2
  exit 1
fi

printf '%s✔ commit-msg OK%s\n' "$GREEN" "$NC" >&2
exit 0
